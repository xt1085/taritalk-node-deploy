# Minotari Mainnet base node configuration written by taritalk-node-deploy
# (unofficial TariTalk community tool). An ordinary non-pruned full node:
# not a seed node, miner or public RPC service. gRPC is disabled, the
# Wallet Query service is local only, and Tor is the system tor.

[base_node]
grpc_enabled = false
grpc_readiness_enabled = false
use_libtor = false

[base_node.storage]
pruning_horizon = 0
track_reorgs = true

[base_node.p2p]
public_addresses = ["/ip4/@PUBLIC_IPV4@/tcp/18189"]
auxiliary_tcp_listener_address = "/ip4/0.0.0.0/tcp/18189"

[base_node.p2p.transport]
type = "tcp_tor"
tcp.listener_address = "/ip4/0.0.0.0/tcp/18189"
tor.control_address = "/ip4/127.0.0.1/tcp/9051"

[base_node.http_wallet_query_service]
listen_ip = "127.0.0.1"

# Official Tari Mainnet seeds, verbatim from tari-project/tari v6.0.0
# common/config/presets/b_peer_seeds.toml ([mainnet.p2p.seeds]).
[mainnet.p2p.seeds]
# DNS seeds hosts - DNS TXT records are queried from these hosts and the resulting peers added to the comms peer list.
# (Default: peer_seeds = [])
dns_seeds = ["seeds.tari.com"]
# Custom specified peer seed nodes (Default: peer_seeds = [])
